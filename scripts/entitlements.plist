<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime allows Nexus to do (used by scripts/build_release.sh with NEXUS_SIGN_ID). -->
<plist version="1.0">
<dict>
  <!-- Hand tracking and "Hey Jarvis" -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Jarvis controls other apps with AppleScript (Music, Notes, Finder...) -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- Python loads its compiled extensions (signed by you, not Apple) -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- PyObjC and ctypes build small callback trampolines at runtime -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
